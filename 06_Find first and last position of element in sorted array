class Solution:
    def searchRange(self, nums: List[int], target: int) -> List[int]:
        ans = [-1,-1]
        if target in nums:
            low = 0
            high = len(nums)-1
            while(low <= high):
                mid = (low+high)//2
                if nums[mid] >= target:
                    high = mid - 1
                else:
                    low = mid + 1
            ans[0] = low
            low = 0 
            high = len(nums)-1
            while(low <= high):
                mid = (low+high)//2
                if nums[mid] > target:
                    high = mid - 1
                else:
                    low = mid + 1
            ans[1] = low-1
            return ans
        return ans
        
